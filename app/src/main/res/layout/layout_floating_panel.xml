<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_card"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部控制栏：方向切换 + 模式切换 + 收起 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDirection"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_button"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="EN → ZH"
            android:textColor="#1A73E8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCaptureMode"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_chip_button"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="节点读词"
            android:textColor="#0F9D58"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnCollapse"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="—"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#EF4444"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 输入框与操作按钮 -->
    <EditText
        android:id="@+id/etSourceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#F3F4F6"
        android:hint="点击下方取词，或直接输入/粘贴..."
        android:maxLines="4"
        android:minLines="2"
        android:padding="8dp"
        android:textColor="#111827"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="读取屏幕"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTranslate"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1A73E8"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="立即翻译"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 翻译结果区 -->
    <TextView
        android:id="@+id/tvSourceMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#6B7280"
        android:textSize="11sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="150dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="准备就绪"
            android:textColor="#1F2937"
            android:textSize="13sp" />
    </ScrollView>

    <TextView
        android:id="@+id/btnCopyResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:padding="4dp"
        android:text="复制结果"
        android:textColor="#1A73E8"
        android:textSize="12sp" />
</LinearLayout>
