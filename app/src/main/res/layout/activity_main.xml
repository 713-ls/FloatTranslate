<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FloatTranslate 全屏即点即译"
            android:textColor="#111827"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• 单击悬浮球：自动读取/自动全屏截图，直接在原文字位置覆盖显示译文（无弹窗、无需输入）
• 长按悬浮球：切换「英→中 / 中→英」
• 双击悬浮球：切换「节点读词 / 全屏识图」"
            android:textColor="#374151"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_floating_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 权限与启动（首次开启一次即可）"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="① 授予悬浮窗权限" />

            <Button
                android:id="@+id/btnAccessibilityPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="② 开启无障碍服务（推荐：零弹窗直接读全屏节点+安卓11以上免授权静默截屏）" />

            <Button
                android:id="@+id/btnScreenCapturePerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="③ 备用：授予全屏截图权限（仅未开无障碍时使用）" />

            <Button
                android:id="@+id/btnToggleFloating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#0F9D58"
                android:text="启动全屏翻译悬浮球" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_floating_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 联网翻译引擎设置"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbFreeApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="免费公开联网接口（Google GTX + MyMemory，免配置）" />

                <RadioButton
                    android:id="@+id/rbCustomApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义大模型 API（适合复杂文献）" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutCustomApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Base URL (例如 https://api.deepseek.com/v1)"
                    android:inputType="textUri"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="API Key (sk-...)"
                    android:inputType="textPassword"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Model (例如 deepseek-chat)"
                    android:inputType="text"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="保存配置" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
