<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FloatTranslate 悬浮翻译"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="支持节点读词 + 框选识图 OCR，免费接口开箱即用，支持自定义 API"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- 权限与启动卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_floating_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. 权限配置"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="授予悬浮窗权限" />

            <Button
                android:id="@+id/btnAccessibilityPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="开启无障碍服务（节点/代码块读词）" />

            <Button
                android:id="@+id/btnScreenCapturePerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="授权截屏识图（框选 OCR 模式）" />

            <Button
                android:id="@+id/btnToggleFloating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#0F9D58"
                android:text="启动悬浮球" />
        </LinearLayout>

        <!-- 翻译引擎设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_floating_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. 翻译引擎设置"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEngine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbFreeApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="免费公开接口（MyMemory + Free Dictionary）" />

                <RadioButton
                    android:id="@+id/rbCustomApi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义 API（OpenAI 兼容，适合复杂文献）" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/layoutCustomApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etBaseUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Base URL (例如 https://api.deepseek.com/v1)"
                    android:inputType="textUri"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="API Key (sk-...)"
                    android:inputType="textPassword"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="Model (例如 deepseek-chat / gpt-4o-mini)"
                    android:inputType="text"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="保存引擎配置" />
        </LinearLayout>

        <!-- 最近查询历史 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_floating_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. 最近翻译缓存"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无缓存记录"
                android:textColor="#374151"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
